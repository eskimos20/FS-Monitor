# FS-Monitor environment configuration
# Copy to /etc/fs-monitor/fs-monitor.env and adjust.
# Permissions: chmod 640, root:fsmonitor

# --- Required on first start ---
# Initial password for the auto-created 'admin' account (first login only).
# If left empty, the password 'password' is used and MUST be changed at login.
FS_MONITOR_ADMIN_PASSWORD=

# --- Secrets ---
# JWT signing secret and the AES key used to encrypt stored credentials.
# Leave empty to auto-generate and persist under FS_MONITOR_DATA_DIR
# (0600 permissions). Set explicitly if you want controlled secrets.
JWT_SECRET=
FS_MONITOR_ENCRYPTION_KEY=

# --- Storage ---
# Persistent data directory (H2 database + generated secrets)
FS_MONITOR_DATA_DIR=/var/lib/fs-monitor

# --- Network ---
SERVER_PORT=8085
SERVER_ADDRESS=0.0.0.0

# Allowed browser origins (comma-separated). Only needed when the UI is
# served from a different origin than the backend.
CORS_ALLOWED_ORIGINS=http://localhost:8085

# --- JVM ---
JAVA_OPTS=-Xms256m -Xmx512m

# --- Optional ---
# SFTP host key verification: path to an OpenSSH known_hosts file.
# When the file exists, StrictHostKeyChecking=yes is enforced.
FSMONITOR_SFTP_KNOWNHOSTS=/var/lib/fs-monitor/known_hosts

# Timeout for external commands executed by the monitors (seconds):
FS_MONITOR_COMMAND_TIMEOUT=120

# Consecutive failed checks before an alert email is sent (default 3).
# Raise to tolerate flapping links; set to 1 to alert on the first failure.
FS_MONITOR_ALERT_FAILURE_THRESHOLD=3
